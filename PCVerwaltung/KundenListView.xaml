<UserControl x:Class="PCVerwaltung.KundenListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PCVerwaltung"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="700">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Kunden" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>

        <DataGrid x:Name="dgKunden" Grid.Row="1"
                  ItemsSource="{Binding Source={x:Static local:App.Kunden}}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" HeadersVisibility="Column"
                  EnableRowVirtualization="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Kundenname"  Binding="{Binding Kundenname}"  Width="2*" />
                <DataGridTextColumn Header="Adresse"     Binding="{Binding Adresse}"     Width="2*" />
                <DataGridTextColumn Header="E-Mail"      Binding="{Binding EMail}"       Width="2*" />
                <DataGridTextColumn Header="Telefon"     Binding="{Binding Telefon}"     Width="*" />
                <DataGridTextColumn Header="Zahlungsart" Binding="{Binding Zahlungsart}" Width="*" />
                <DataGridTextColumn Header="Ranking"     Binding="{Binding Ranking}"     Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="2" Content="Kunde löschen"
                Click="OnKundeLoeschen"
                HorizontalAlignment="Right" Margin="0,8,0,0"
                Padding="12,4"/>
    </Grid>
</UserControl>
